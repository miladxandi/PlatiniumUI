<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage x:Class="PlatiniumUI.Sample.Pages.DataDisplayPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:data="clr-namespace:PlatiniumUI.Fluent.Controls.DataDisplay;assembly=PlatiniumUI.Fluent"
    Title="Data Display" BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1A1A1A}">
    <ScrollView>
        <VerticalStackLayout Padding="16,24" Spacing="24">
            <Label Text="Data Display" FontSize="20" FontAttributes="Bold"
                   TextColor="{AppThemeBinding Light=#1A1A1A, Dark=#FFFFFF}" />

            <!-- Badge -->
            <VerticalStackLayout Spacing="8">
                <Label Text="Badge" FontSize="16" FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light=#1A1A1A, Dark=#FFFFFF}" />
                <HorizontalStackLayout Spacing="16">
                    <data:FlBadge BadgeType="Dot" Text="">
                        <data:FlBadge.BadgeContent>
                            <Border WidthRequest="40" HeightRequest="40"
                                    StrokeShape="RoundRectangle" BackgroundColor="{AppThemeBinding Light=#E0E0E0, Dark=#3A3A3A}" />
                        </data:FlBadge.BadgeContent>
                    </data:FlBadge>
                    <data:FlBadge BadgeType="Count" Text="5">
                        <data:FlBadge.BadgeContent>
                            <Border WidthRequest="40" HeightRequest="40"
                                    StrokeShape="RoundRectangle" BackgroundColor="{AppThemeBinding Light=#E0E0E0, Dark=#3A3A3A}" />
                        </data:FlBadge.BadgeContent>
                    </data:FlBadge>
                    <data:FlBadge BadgeType="Label" Text="New">
                        <data:FlBadge.BadgeContent>
                            <Border WidthRequest="40" HeightRequest="40"
                                    StrokeShape="RoundRectangle" BackgroundColor="{AppThemeBinding Light=#E0E0E0, Dark=#3A3A3A}" />
                        </data:FlBadge.BadgeContent>
                    </data:FlBadge>
                </HorizontalStackLayout>
            </VerticalStackLayout>

            <!-- Avatar -->
            <VerticalStackLayout Spacing="8">
                <Label Text="Avatar" FontSize="16" FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light=#1A1A1A, Dark=#FFFFFF}" />
                <HorizontalStackLayout Spacing="12">
                    <data:FlAvatar Text="John Doe" Size="40" />
                    <data:FlAvatar Text="Jane Smith" Size="40" />
                    <data:FlAvatar Text="Bob Wilson" Size="40" />
                </HorizontalStackLayout>
            </VerticalStackLayout>

            <!-- Avatar Group -->
            <VerticalStackLayout Spacing="8">
                <Label Text="Avatar Group" FontSize="16" FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light=#1A1A1A, Dark=#FFFFFF}" />
                <data:FlAvatarGroup x:Name="avatarGroup" />
            </VerticalStackLayout>

            <!-- Tooltip -->
            <VerticalStackLayout Spacing="8">
                <Label Text="Tooltip" FontSize="16" FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light=#1A1A1A, Dark=#FFFFFF}" />
                <data:FlTooltip Text="This is a helpful tooltip">
                    <Border Padding="12,8"
                            StrokeShape="RoundRectangle"
                            BackgroundColor="{AppThemeBinding Light=#F26522, Dark=#F26522}">
                        <Label Text="Hover me" TextColor="White" />
                    </Border>
                </data:FlTooltip>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
